pinsel 1 800 600
stil aquarell
seed 31
licht oben-rechts kraft 0.35
farbe himmel 4f8ad0
farbe gras 7a9a3e
farbe rot e8341a
farbe ocker e6c46c
farbe fern 92a2c4
hintergrund farbe papier

; mohn im wind: stiel biegt nach rechts, bluete kippt mit
vorlage mohn r=8
  linie 0,0 r*0.3,-r*2 r*1.2,-r*3.8 breite r*0.2..r*0.1 farbe gras-25 deckkraft 0.85
  teil bluete r*1.2 -r*4 drehung 20+z*25
    form -r,0 -r*0.8,-r*0.6 -r*0.2,-r*0.8 r*0.4,-r*0.85 r*0.95,-r*0.5 r*1.05,r*0.1 r*0.6,r*0.6 0,r*0.7 -r*0.65,r*0.5 farbe rot+z*12 flach
    form 0,-r*0.15 r*0.45,-r*0.75 r*0.95,-r*0.45 r*0.6,r*0.05 farbe rot+30 deckkraft 0.65 flach
    form -r*0.9,r*0.1 -r*0.2,r*0.15 0,r*0.65 -r*0.6,r*0.45 farbe rot-22 deckkraft 0.6 flach
    ellipse r*0.05 -r*0.05 r*0.22 r*0.16 farbe 3a2c48 flach

vorlage rotfleck r=40
  ellipse 0 0 r r*0.3 farbe rot+z*20 nass deckkraft 0.4+z*0.2 flach

vorlage tupfer r=4
  ellipse 0 0 r r*0.65 farbe rot+z*15 drehung -10+z*30 flach

vorlage halm h=30
  linie 0,0 h*0.2,-h*0.5 h*0.6,-h breite 2..0.4 farbe gras-15+z*30 trocken deckkraft 0.7

; 1. himmel: grosse nasse lasur, schraeg, oben links satter
rechteck 0 0 800 400 verlauf himmel-12 himmel+15 himmel+40 70 nass deckkraft 0.9

; wolken ausgespart, vom wind gezogen
form 260,230 300,200 360,190 400,150 460,130 520,140 560,110 630,100 690,120 740,105 800,115 800,215 720,225 640,238 560,240 470,250 380,252 300,250 aussparen nass
form 0,90 50,75 110,82 160,62 210,70 240,95 180,110 110,118 40,120 0,118 aussparen nass
form 520,300 580,292 640,296 690,288 740,300 680,312 600,314 540,312 aussparen nass
; wolkenbaeuche, kuehl violett-grau, nass
form 300,245 400,232 480,226 560,222 650,214 730,208 800,205 800,218 720,228 620,240 520,244 420,252 320,254 farbe fern nass deckkraft 0.55
form 600,160 650,150 700,165 690,195 640,205 600,190 farbe fern+20 nass deckkraft 0.3
form 40,110 110,104 180,100 200,110 120,120 50,122 farbe fern+10 nass deckkraft 0.4

; ferne baumgruppe, blau und weich
