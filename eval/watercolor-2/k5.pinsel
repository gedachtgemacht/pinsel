streue tupfer 260 bereich 0 388 800 50 skala 0.35..0.8 tiefe deckkraft 0.85
streue tupfer 160 bereich 0 430 800 80 skala 0.8..1.4 deckkraft 0.8

; gras im wind
streue halm 200 bereich 0 470 800 130 skala 0.9..2.2 tiefe

; mittelgrund mohn
streue mohn 30 bereich 0 470 800 50 skala 0.55..0.8 tiefe

; links ein paar, locker, kleiner
nutze mohn 80 600 r=12
nutze mohn 130 592 r=10

; blickpunkt: gruppe rechts im goldenen schnitt
nutze mohn 440 610 r=20
nutze mohn 505 620 r=38
nutze mohn 600 612 r=26
nutze mohn 570 560 r=13
nutze mohn 660 575 r=12

