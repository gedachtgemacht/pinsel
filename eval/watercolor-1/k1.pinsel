; blickpunkt: dunkle landzunge mit tannen, linkes drittel
vorlage tanne h=60
  form 0,-h! -h*0.1,-h*0.7 -h*0.2,-h*0.35 -h*0.24,0! h*0.24,0! h*0.2,-h*0.35 h*0.1,-h*0.7 farbe tanne+z*25 flach

; ferne tannen im nebel, nur geahnt
teil ferne 0 0 deckkraft 0.22
  streue tanne 9 bereich 330 344 180 8 skala 0.25..0.45 h=70
form 90,374 170,364 250,367 300,375 250,380 120,381 farbe tanne+20 deckkraft 0.8 weich 1 flach
streue tanne 7 bereich 120 360 110 14 skala 0.5..0.9 h=70
nutze tanne 222 370 h=110
nutze tanne 240 372 h=72
nutze tanne 202 371 h=82
; spiegelung, nach unten gestreckt und verwaschen
wiederhole i 9
  linie 130+i*14,384 130+i*14+zuf(-2,2),400+zuf(0,30) breite 8..1 farbe tanne+25 deckkraft 0.4 weich 2

